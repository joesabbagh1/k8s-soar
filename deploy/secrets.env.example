# Copy to deploy/secrets.env (gitignored) and fill what you use; then `make secrets`.
# Everything is optional. Values are stored as Kubernetes Secrets, never in Helm values.

# `./k8s-soar configure` writes this file for you.

# --- Notification channels -------------------------------------------------
# Slack incoming webhook (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=
# Microsoft Teams: Workflows app -> "Post to a channel when a webhook request is received"
TEAMS_WEBHOOK_URL=
# Google Chat: Space -> Apps & integrations -> Webhooks
GOOGLE_CHAT_WEBHOOK_URL=
# Generic webhook: case JSON POSTed here; with a secret, signed in X-K8s-Soar-Signature
WEBHOOK_URL=
WEBHOOK_SECRET=
# Email (SMTP). SMTP_TLS: starttls (587) | ssl (465) | none. SMTP_TO: comma-separated
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# PagerDuty Events API v2 integration key (pages from k8sSoar.integrations.pagerdutyMinSeverity up)
PAGERDUTY_ROUTING_KEY=

# Jira Cloud (API token: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_URL=            # https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=    # e.g. SEC

# Grafana service-account token (Editor) for incident annotations on dashboards
GRAFANA_API_TOKEN=

# AI triage provider key (provider/model are set in deploy/profiles/*.yaml -> k8sSoar.ai)
AI_API_KEY=

# Optional: fixed Grafana admin password (otherwise generated on first run)
GRAFANA_ADMIN_PASSWORD=
